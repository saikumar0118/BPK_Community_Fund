# ==============================================================================
# PBK Community Fund - Environment Variables Template
# Copy this file to '.env' and update with your local configuration
# Command: copy .env.example .env
# ==============================================================================

# Database Connection Settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=pbk_db

# SQLAlchemy Connection String
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/pbk_db

# Application Configuration
APP_ENV=development
APP_PORT=8000
APP_HOST=127.0.0.1
DEBUG=True

# Security (JWT / Secret Keys if needed)
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440


